# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories. build/ holds the build and deploy SCRIPTS, which are
# source and are tracked; only its output is ignored.
# (no bare Build/ line: ignore matching is case-insensitive on Windows, so it
# silently re-ignored build/ and the scripts with it.)
build/out/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Game assets must never be committed - the player's own install supplies them.
# A committed SLP, DRS or palette dump is redistribution. See
# Docs/ClaudeCode/PROJECT_OVERVIEW.md section 2 (Constraints).
*.drs
*.slp
*.dat
*.pal
*.per
*.scx
*.mgx
*.mgz

# Later ports (Docs/FutureGames): same rule, more formats.
*.mix
*.MIX
*.mpq
*.MPQ
*.shp
*.vxl
*.hva
*.grp
*.aud
*.vqa
*.bag

Release/
